{
  "manifest_version": 3,
  "name": "Zonex - Professional Timezone Converter",
  "version": "1.1.0",
  "description": "A professional timezone converter extension with daylight saving time support, world clock, meeting planner, and user-friendly interface",
  "author": "Zonex Team",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Z",
        "mac": "Command+Shift+Z"
      },
      "description": "Open Zonex timezone converter"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zonex - Timezone Converter",
    "default_icon": {
      "16": "icons/icon16.svg",
      "32": "icons/icon32.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "32": "icons/icon32.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
